[Unit]
Description=pidvault mount helper
Documentation=man:pidvault(1) https://github.com/torstei/pidvault
Requires=pidvault-mount.socket
After=pidvault-mount.socket

[Service]
Type=exec
ExecStart=/usr/bin/pidvault mount-helper
ExecStopPost=-/usr/bin/umount --lazy /run/pidvault
Restart=on-failure
UMask=0022

# Root, and without a private mount namespace: the mount must be the host's, or users
# would not see it. So nothing here may create one (ProtectSystem=, ProtectHome=,
# PrivateTmp=, PrivateDevices=, ProtectKernelModules=, ...); what remains is restricted.
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/fuse rw
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
