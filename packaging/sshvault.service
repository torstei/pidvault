[Unit]
Description=Per-shell access to encrypted SSH configuration
Requires=sshvault.socket sshvault-mount.socket
After=sshvault.socket sshvault-mount.socket local-fs.target systemd-sysusers.service

[Service]
Type=exec
User=sshvault
Group=sshvault
# Never root: the mount, the one step that needs it, is made by sshvault-mount.service,
# which hands over the FUSE connection and unmounts once this daemon is gone.
ExecStart=/usr/bin/sshvault daemon
Restart=on-failure

StateDirectory=sshvault
StateDirectoryMode=0700
UMask=0077
# decrypted vaults are held in locked memory, up to 4 MiB per user
LimitMEMLOCK=64M
LimitCORE=0

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProcSubset=pid
SystemCallErrorNumber=EPERM
# Not PrivateUsers=: callers are identified by uid, which it would remap. Not
# ProtectProc=: whether a caller descends from an unlocked shell is read from other
# users' /proc entries.

[Install]
WantedBy=multi-user.target
